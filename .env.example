# ==========================================
# VULMINI ENVIRONMENT CONFIGURATION
# ==========================================
# Gemini generates .env from this template during initial deployment.
# NEVER commit your .env to Git!

# ── Domain ──
DOMAIN_NAME=vulmini.wl.mk
LETSENCRYPT_EMAIL=admin@vulmini.wl.mk

# ── Database (MariaDB) ──
DB_NAME=vulmini_lms
DB_USER=vulmini_user
DB_PASSWORD=generate_secure_password_here
DB_ROOT_PASSWORD=generate_root_password_here

# ── Vultr API ──
VULTR_API_KEY=your_vultr_api_key_here
VULTR_REGION=tlv
VULTR_PLAN=vhf-2c-4gb
VULTR_PROD_INSTANCE_ID=

# ── Vultr Object Storage (S3 for media) ──
# Gemini will populate this data after creating the bucket via the Vultr API
S3_ACCESS_KEY=placeholder
S3_SECRET_KEY=placeholder
S3_BUCKET_NAME=vulmini-media-bucket
S3_REGION=tlv1
S3_URL=https://tlv1.vultrobjects.com

# ── SSH (for MCP Server) ──
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PRIVATE_KEY_PATH=~/.ssh/vulmini_rsa

# ── System Limits ──
PHP_MEMORY_LIMIT=512M
UPLOAD_MAX_FILESIZE=2G

# ── WordPress Salts ──
# Automatically generated on first launch via WP-CLI
# wp config shuffle-salts
