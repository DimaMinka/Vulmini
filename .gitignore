# ==========================================
# VULMINI .gitignore
# ==========================================

# WordPress core - downloaded dynamically via WP-CLI
wordpress-core/*
!wordpress-core/.gitkeep

# Secrets
.env
*.env.local

# Docker volumes data
volumes/

# Backups
backups/
*.sql
*.sql.gz
*.tar.gz

# MCP Server
mcp-server/node_modules/
mcp-server/dist/
mcp-server/.env

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.code-workspace

# Logs
*.log
logs/

# SSL Certificates (managed by Certbot)
certs/

# Antigravity CLI
.antigravitycli/

# Temporary development files and agent logs
.agents/
ORIGINAL_REQUEST.md
TEST_READY.md

