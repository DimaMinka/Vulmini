{
  "name": "vulmini-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Vulmini — Gemini-managed WordPress infrastructure on Vultr",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "vulmini-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "test:e2e": "NODE_PATH=$(pwd)/node_modules tsx ../tests/run.ts",
    "mcp:up": "node remote-up.js mcp",
    "mcp:down": "node remote-down.js mcp",
    "stage:up": "node remote-up.js stage",
    "stage:down": "node remote-down.js stage",
    "prod:up": "node remote-up.js prod",
    "prod:down": "node remote-down.js prod"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "ssh2": "^1.16.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.4",
    "prettier": "^3.8.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
